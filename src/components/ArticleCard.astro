---
const { article } = Astro.props;
---

<article class="article-card">
  <p class="eyebrow">{article.data.category}</p>
  <h2><a href={`/articles/${article.slug}/`}>{article.data.title}</a></h2>
  <p>{article.data.description}</p>
  <time datetime={article.data.publishedDate.toISOString()}>
    {article.data.publishedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })}
  </time>
</article>
