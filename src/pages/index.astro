---
import { Image } from 'astro:assets';
import ArticleCard from '@/components/ArticleCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import homeHeroImage from '@/assets/japan-living-edit-home-hero.png';
import { getPublishedArticles } from '@/lib/articles';
import { categories, site } from '@/lib/site';

const articles = await getPublishedArticles();
---

<BaseLayout title={site.name} description={site.description} pathname="/" image={homeHeroImage.src}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Independent editorial from Japan</p>
      <h1>Japanese Products, Designed with Purpose</h1>
      <p>
        Discover thoughtfully designed Japanese tools and everyday objects through their
        materials, function, construction, and the details that shape how they are used.
      </p>
      <a class="button" href="/articles/">Explore Articles</a>
    </div>
    <figure class="hero-visual">
      <Image
        src={homeHeroImage}
        alt="Editorial still life of cookware, ceramics, textiles, and greenery representing Japanese everyday design."
        widths={[640, 960, 1280]}
        sizes="(min-width: 720px) 42vw, calc(100vw - 2rem)"
        format="webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Categories</p>
      <h2>Calm, practical areas of focus.</h2>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <article class="category-card">
          <h3>{category.title}</h3>
          <p>{category.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section muted">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2>Articles</h2>
    </div>
    <div class="article-grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
