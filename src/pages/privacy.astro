---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="Current privacy practices for Japan Living Edit."
  pathname="/privacy/"
>
  <section class="page-intro">
    <p class="eyebrow">Privacy</p>
    <h1>Privacy policy</h1>
    <p>
      Japan Living Edit is currently a static editorial website without analytics,
      advertising scripts, affiliate tracking or newsletter collection.
    </p>
  </section>
  <section class="text-block">
    <h2>Current setup</h2>
    <ul>
      <li>No Google Analytics is installed.</li>
      <li>No advertising scripts are installed.</li>
      <li>No affiliate tracking scripts are installed.</li>
      <li>No newsletter signup or contact form is active.</li>
    </ul>
    <h2>Future updates</h2>
    <p>
      If analytics, advertising, affiliate tracking, newsletter tools or other data
      collection features are added later, this page should be reviewed and updated
      before those features go live.
    </p>
    <!-- Privacy reminder: update this page before adding analytics, ads, affiliate tracking, newsletter tools or forms. -->
  </section>
</BaseLayout>
