---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="Current privacy practices for Japan Living Edit."
  pathname="/privacy/"
>
  <section class="page-intro">
    <p class="eyebrow">Privacy</p>
    <h1>Privacy policy</h1>
    <p>
      Japan Living Edit is currently a static editorial website. Some articles
      contain external affiliate links to Amazon Japan, as described below.
    </p>
  </section>
  <section class="text-block">
    <h2>Current setup</h2>
    <ul>
      <li>No Google Analytics is installed.</li>
      <li>No advertising scripts are installed.</li>
      <li>No affiliate tracking scripts are installed.</li>
      <li>No newsletter signup or contact form is active.</li>
    </ul>
    <h2>External affiliate links</h2>
    <p>
      Some articles contain Amazon Associates affiliate links to Amazon Japan.
      These external links include identifying parameters for the affiliate
      relationship. Articles containing affiliate links include an article-level
      disclosure.
    </p>
    <p>
      After you open an external link, information handling by the destination
      service is governed by that service's privacy policy.
    </p>
    <h2>Future updates</h2>
    <p>
      If analytics, advertising, affiliate tracking scripts, newsletter tools or other data
      collection features are added later, this page should be reviewed and updated
      before those features go live.
    </p>
    <!-- Privacy reminder: update this page before adding analytics, ads, affiliate tracking scripts, newsletter tools or forms. -->
  </section>
</BaseLayout>
