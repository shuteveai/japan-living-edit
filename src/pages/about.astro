---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About Japan Living Edit, an independent English-language editorial website based in Japan."
  pathname="/about/"
>
  <section class="page-intro">
    <p class="eyebrow">About</p>
    <h1>An independent editorial view on everyday living from Japan.</h1>
    <p>
      Japan Living Edit is a Japan-based independent editorial website publishing
      English-language content for international readers, with a primary focus on
      readers in the United States.
    </p>
  </section>
  <section class="text-block">
    <p>
      The site covers Japanese products and everyday living ideas across organization,
      small-space living, kitchen tools and coffee. It is not an official website for
      any brand, retailer or affiliate program.
    </p>
    <p>
      The editorial goal is simple: explain what makes certain objects, routines and
      home ideas useful, calm and practical for real daily life.
    </p>
  </section>
</BaseLayout>
