---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Affiliate Disclosure"
  description="Affiliate disclosure for Japan Living Edit."
  pathname="/disclosure/"
>
  <section class="page-intro">
    <p class="eyebrow">Disclosure</p>
    <h1>Affiliate disclosure</h1>
    <p>
      Japan Living Edit may earn commissions from qualifying purchases made through
      affiliate links.
    </p>
  </section>
  <section class="text-block">
    <p>
      Japan Living Edit participates in the Amazon Associates Program. As an Amazon Associate, Japan Living Edit earns from qualifying purchases.
    </p>
    <p>
      Affiliate relationships do not determine our editorial opinions or conclusions.
      Products should not receive positive coverage merely because an affiliate
      relationship exists.
    </p>
    <p>
      Readers do not pay an additional charge solely because they use an affiliate
      link. Articles that contain affiliate links should identify that clearly near
      the article itself.
    </p>
  </section>
</BaseLayout>
