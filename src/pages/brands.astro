---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Brands"
  description="A future index for Japanese lifestyle brands that may be covered editorially by Japan Living Edit."
  pathname="/brands/"
>
  <section class="page-intro">
    <p class="eyebrow">Brands</p>
    <h1>A future guide to Japanese lifestyle brands.</h1>
    <p>
      This page is reserved for future editorial brand profiles. Any coverage will be
      written independently and clearly disclosed.
    </p>
  </section>
  <section class="brand-list">
    <article>
      <h2>Yamazaki Home</h2>
      <p>
        A Japanese home organization brand that may be covered in future editorial
        articles. Japan Living Edit is not currently claiming any official partnership
        or affiliate approval.
      </p>
    </article>
    <article>
      <h2>KINTO</h2>
      <p>
        A Japanese tableware, drinkware and coffee-related brand that may be covered
        in future editorial articles. No affiliate relationship is claimed at this time.
      </p>
    </article>
  </section>
</BaseLayout>
