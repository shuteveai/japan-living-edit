---
import BaseLayout from '@/layouts/BaseLayout.astro';

const contactEmail = 'hello@japanlivingedit.com';
---

<BaseLayout
  title="Contact"
  description="Contact Japan Living Edit for editorial inquiries, corrections, brand information and general questions."
  pathname="/contact/"
>
  <section class="page-intro">
    <p class="eyebrow">Contact</p>
    <h1>Contact Japan Living Edit.</h1>
    <p>
      For editorial inquiries, corrections, brand information or general questions,
      please use the email below.
    </p>
  </section>
  <section class="text-block">
    <p>Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
  </section>
</BaseLayout>
