---
import BaseLayout from '@/layouts/BaseLayout.astro';

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
---

<BaseLayout
  title="Contact"
  description="Contact information for Japan Living Edit."
  pathname="/contact/"
>
  <section class="page-intro">
    <p class="eyebrow">Contact</p>
    <h1>Contact Japan Living Edit.</h1>
    <p>
      A direct contact address will be added after an official site email is selected.
    </p>
  </section>
  <section class="text-block">
    {contactEmail ? (
      <p>Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    ) : (
      <p>No public contact email is listed yet.</p>
    )}
  </section>
</BaseLayout>
