---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import { site } from '@/lib/site';

const { entry } = Astro.props;
const canonical = entry.data.canonicalURL ?? `${site.url}/articles/${entry.slug}/`;
const heroImage = entry.data.heroImage;
const heroImageAlt = entry.data.heroImageAlt;
const heroImageUrl = heroImage ? new URL(heroImage.src, site.url).toString() : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.publishedDate).toISOString(),
  mainEntityOfPage: canonical,
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
};
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description}
  pathname={`/articles/${entry.slug}/`}
  type="article"
  image={heroImage?.src}
>
  <article class="article-shell">
    <p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <p class="article-meta">
      Published <time datetime={entry.data.publishedDate.toISOString()}>{entry.data.publishedDate.toLocaleDateString('en-US')}</time>
    </p>
    <p class="notice">{entry.data.affiliateDisclosure}</p>
    {
      heroImage && heroImageAlt && (
        <figure class="article-hero-image">
          <Image src={heroImage} alt={heroImageAlt} widths={[640, 960, 1280]} sizes="(min-width: 760px) 760px, calc(100vw - 2rem)" />
        </figure>
      )
    }
    <div class="prose">
      <slot />
    </div>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
