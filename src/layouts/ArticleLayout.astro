---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import ChikuhodoBrushVisual from '@/components/ChikuhodoBrushVisual.astro';
import CoffeeCornerVisual from '@/components/CoffeeCornerVisual.astro';
import Custom823FillingVisual from '@/components/Custom823FillingVisual.astro';
import DrawALineVisual from '@/components/DrawALineVisual.astro';
import EntrywayVisual from '@/components/EntrywayVisual.astro';
import GeoProductVisual from '@/components/GeoProductVisual.astro';
import ImabariTowelVisual from '@/components/ImabariTowelVisual.astro';
import IshikawaBrushVisual from '@/components/IshikawaBrushVisual.astro';
import NambuIronwareVisual from '@/components/NambuIronwareVisual.astro';
import type { CollectionEntry } from 'astro:content';
import { getPublishedArticles } from '@/lib/articles';
import { getCategorySlug, site } from '@/lib/site';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const relatedArticles = (await getPublishedArticles())
  .filter((article) => article.slug !== entry.slug && article.data.category === entry.data.category)
  .slice(0, 3);
const canonical = entry.data.canonicalURL ?? `${site.url}/articles/${entry.slug}/`;
const heroImage = entry.data.heroImage;
const heroImageAlt = entry.data.heroImageAlt;
const heroImageUrl = heroImage ? new URL(heroImage.src, site.url).toString() : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.publishedDate).toISOString(),
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: site.name,
    url: `${site.url}/about/`,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
};
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description}
  pathname={`/articles/${entry.slug}/`}
  canonical={canonical}
  type="article"
  image={heroImage?.src}
>
  <article class="article-shell">
    <p class="eyebrow"><a href={`/categories/${getCategorySlug(entry.data.category)}/`}>{entry.data.category}</a></p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <p class="article-meta">
      By <a href="/about/">{site.name}</a> ·
      Published <time datetime={entry.data.publishedDate.toISOString()}>{entry.data.publishedDate.toLocaleDateString('en-US')}</time>
    </p>
    <p class="notice">{entry.data.affiliateDisclosure}</p>
    {
      heroImage && heroImageAlt && (
        <figure class="article-hero-image">
          <Image src={heroImage} alt={heroImageAlt} widths={[640, 960, 1280]} sizes="(min-width: 760px) 760px, calc(100vw - 2rem)" />
        </figure>
      )
    }
    {entry.slug === 'japanese-inspired-coffee-corner-at-home' && <CoffeeCornerVisual />}
    {entry.slug === 'how-to-use-vertical-space-small-apartment' && <DrawALineVisual />}
    {entry.slug === 'small-entryway-organization-ideas-apartments' && <EntrywayVisual />}
    {entry.slug === 'inside-geo-product-japanese-cookware-seven-layers' && <GeoProductVisual />}
    {entry.slug === 'pilot-custom-823-vacuum-filling-system' && <Custom823FillingVisual />}
    {entry.slug === 'why-japanese-clothes-brush-costs-50000-yen' && <IshikawaBrushVisual />}
    {entry.slug === 'imabari-towel-five-second-rule' && <ImabariTowelVisual />}
    {entry.slug === 'nambu-iron-kettle-vs-cast-iron-teapot' && <NambuIronwareVisual />}
    {entry.slug === 'how-chikuhodo-kumano-makeup-brush-is-made' && <ChikuhodoBrushVisual />}
    <div class="prose">
      <slot />
    </div>
    {relatedArticles.length > 0 && (
      <section class="related-articles" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading">More in {entry.data.category}</h2>
        <ul>
          {relatedArticles.map((article) => (
            <li><a href={`/articles/${article.slug}/`}>{article.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
